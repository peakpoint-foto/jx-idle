{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jx-idle-final",
  "main": "worker/src/index.js",
  // Đóng gói mã game cho máy chủ (worker/gen/game.js) trước mỗi lần dev/deploy.
  "build": { "command": "node worker/build-game.mjs", "watch_dir": "worker/src" },
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jx-idle-final-db",
      "database_id": "65f253d1-733b-4ab3-b1b5-7ffad08972af",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Bản xem trước của PR (Workers Builds chạy `wrangler preview`). Binding D1 không kế thừa vào đây,
  // nên bản xem trước không chạm dữ liệu thật; API online ở bản xem trước trả 503 "no_db".
  "previews": {}
  // Biến tùy chọn (Settings > Variables and Secrets):
  //   TURNSTILE_SITEKEY (biến) + TURNSTILE_SECRET (secret): bật chống bot khi đăng ký.
  //   IP_SALT (secret): muối khi băm IP.
  //   ADMIN_KEY (secret, ≥16 ký tự): khóa cho /api/admin/* (xem và gỡ cờ nghi gian lận, đọc góp ý).
  //   FEEDBACK_WEBHOOK (secret, tùy chọn): URL webhook Discord/Slack nhận thông báo khi có góp ý mới.
}
