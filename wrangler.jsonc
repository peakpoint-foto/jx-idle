{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jx-idle-final",
  "main": "worker/src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Không ghi database_id: Wrangler tự tạo D1 "jx-idle-final-db" ở lần deploy đầu.
  // Nếu đã có D1 sẵn, thêm "database_id": "<id>" vào đây.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jx-idle-final-db",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
  // Biến tùy chọn (Settings > Variables and Secrets):
  //   TURNSTILE_SITEKEY (biến) + TURNSTILE_SECRET (secret): bật chống bot khi đăng ký.
  //   IP_SALT (secret): muối khi băm IP.
}
